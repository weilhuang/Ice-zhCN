      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针位置"
          }
        }
      }
    },
    "The Ice Bar's location changes based on context": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 栏的位置会随使用情境自动调整"
          }
        }
      }
    },
    "The Ice Bar is centered below the mouse pointer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 栏显示在指针正下方"
          }
        }
      }
    },
    "The Ice Bar is centered below the Ice icon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 栏显示在 Ice 图标正下方"
          }
