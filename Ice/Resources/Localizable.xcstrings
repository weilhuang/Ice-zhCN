      }
    },
    "Show on click": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按显示"
          }
        }
      }
    },
    "Click inside an empty area of the menu bar to show hidden menu bar items": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按菜单栏空白处即可显示已隐藏的菜单栏项目"
          }
        }
      }
