    "Hover over an empty area of the menu bar to show hidden menu bar items": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针移到菜单栏空白处即可显示已隐藏的菜单栏项目"
