      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简体中文"
          }
        }
      }
    },
    "Ice will restart so menus and panels can switch languages.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 将重新打开，以便菜单和浮层一并切换语言。"
          }
        }
      }
    },
    "Restart Ice to apply the new language?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要重新打开 Ice 以应用新语言吗？"
          }
        }
      }
    },
    "Ice needs to restart before every part of the interface can use the language you selected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新打开 Ice 后，界面的各个部分才会全部使用所选语言。"
          }
        }
      }
    },
    "Restart Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重新打开"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时打开"
          }
        }
      }
    },
    "Show Ice icon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 Ice 图标"
          }
        }
      }
    },
    "You can still access Ice's settings by right-clicking an empty area in the menu bar": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使隐藏图标，你仍可在菜单栏空白处点按鼠标右键打开 Ice 设置"
          }
        }
      }
    },
    "Ice icon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 图标"
          }
        }
      }
    },
