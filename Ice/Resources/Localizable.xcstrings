      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择图像…"
          }
        }
      }
    },
    "Choose a custom icon to show in the menu bar": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要显示在菜单栏中的自定图标"
