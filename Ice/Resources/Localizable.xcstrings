      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Ice 栏"
          }
        }
      }
    },
    "Show hidden menu bar items in a separate bar below the menu bar": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏下方的独立栏中显示已隐藏的菜单栏项目"
          }
        }
      }
